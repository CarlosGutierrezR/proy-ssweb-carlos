---
import Layout from '../../layouts/Layout.astro';
import productos from '../../data/productos.json';

type Producto = {
  id?: number;
  título: string;
  descripción?: string;
  precio: string | number;
  imagen: string;
};

export async function getStaticPaths() {
  const slugify = (value: string) =>
    value
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/(^-|-$)/g, '');

  return (productos as Producto[]).map((producto, index) => ({
    params: {
      slug: `${slugify(producto.título)}-${index + 1}`
    },
    props: {
      producto
    }
  }));
}

const { producto } = Astro.props as { producto: Producto };
---

<Layout title={`${producto.título} · Producto SSG`}>
  <section class="max-w-5xl mx-auto p-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
      <div class="bg-base-200 rounded-box p-8">
        <img
          src={`/images/${producto.imagen}`}
          alt={producto.título}
          class="h-96 w-full object-contain"
        />
      </div>

      <div>
        <div class="breadcrumbs text-sm mb-4">
          <ul>
            <li><a href="/">Portada</a></li>
            <li><a href="/ssg">Destacados</a></li>
            <li>Producto</li>
          </ul>
        </div>

        <h1 class="text-4xl font-bold mb-4">{producto.título}</h1>

        <p class="text-2xl font-bold mb-6">{producto.precio} €</p>

        <p class="opacity-80 mb-6">
          {producto.descripción || 'Sin descripción disponible.'}
        </p>

        <a href="/ssg" class="btn btn-primary">
          Volver a destacados
        </a>
      </div>
    </div>
  </section>
</Layout>
